# ============================================
# Stage 1: Base image with pnpm + turbo
# ============================================
FROM node:20-alpine AS base

RUN apk add --no-cache libc6-compat
RUN corepack enable && corepack prepare pnpm@10.4.1 --activate
RUN npm install -g turbo@^2

# ============================================
# Stage 2: Prune monorepo for web
# ============================================
FROM base AS pruned

WORKDIR /app
COPY . .
RUN turbo prune web --docker

# ============================================
# Stage 3: Install dependencies
# ============================================
FROM base AS deps

WORKDIR /app

# Restore pruned package manifests (better layer caching)
COPY --from=pruned /app/out/json/ .
COPY --from=pruned /app/out/pnpm-lock.yaml ./pnpm-lock.yaml
COPY --from=pruned /app/out/pnpm-workspace.yaml ./pnpm-workspace.yaml

RUN pnpm install --prefer-offline --ignore-scripts

# Copy full source after install for better caching
COPY --from=pruned /app/out/full/ .

# ============================================
# Stage 4: Development runner
# ============================================
FROM base AS runner

WORKDIR /app

COPY --from=deps /app/ .

ENV NODE_ENV=development
ENV NEXT_TELEMETRY_DISABLED=1
ENV HOSTNAME=0.0.0.0
ENV PORT=3000

EXPOSE 3000

# Run next dev WITHOUT --turbopack: turbopack virtualises __dirname which breaks
# Prisma's binary engine path discovery (resolves to /ROOT/... instead of /app/...)
CMD ["pnpm", "--filter", "web", "exec", "next", "dev"]
