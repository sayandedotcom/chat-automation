# ============================================
# Stage 1: Base image with pnpm + turbo
# ============================================
FROM node:20-alpine AS base

RUN apk add --no-cache libc6-compat
RUN corepack enable && corepack prepare pnpm@10.4.1 --activate
RUN npm install -g turbo@^2

# ============================================
# Stage 2: Prune monorepo for api
# ============================================
FROM base AS pruned

WORKDIR /app
COPY . .
RUN turbo prune api --docker

# ============================================
# Stage 3: Install dependencies
# ============================================
FROM base AS deps

WORKDIR /app

# Restore pruned package manifests (better layer caching)
COPY --from=pruned /app/out/json/ .
COPY --from=pruned /app/out/pnpm-lock.yaml ./pnpm-lock.yaml
COPY --from=pruned /app/out/pnpm-workspace.yaml ./pnpm-workspace.yaml

RUN pnpm install --prefer-offline --ignore-scripts

# Copy full source after install for better caching
COPY --from=pruned /app/out/full/ .

# Generate Prisma client (required by @workspace/database)
RUN pnpm --filter @workspace/database run db:generate

# ============================================
# Stage 4: Development runner
# ============================================
FROM base AS runner

WORKDIR /app

COPY --from=deps /app/ .

ENV NODE_ENV=development

EXPOSE 8000

# Run migrations then start dev server with hot-reload
CMD sh -c "pnpm --filter @workspace/database run db:migrate:deploy && pnpm --filter api dev"
