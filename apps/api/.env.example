# Database
DATABASE_URL=your-postgresql-connection-string

# Session Secret for JWE encryption (32+ characters)
SESSION_SECRET=your-session-secret-min-32-chars

# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=https://your-api-domain.com/auth/google/callback

# App URLs
APP_URL=https://your-frontend-domain.com
API_BASE_URL=https://your-api-domain.com
AGENT_API_URL=https://your-agent-domain.com

# Notion OAuth
NOTION_CLIENT_ID=your-notion-client-id
NOTION_CLIENT_SECRET=your-notion-client-secret
NOTION_REDIRECT_URI=https://your-api-domain.com/oauth/notion/callback

# Optional: override individual OAuth callback URIs
# GMAIL_REDIRECT_URI=http://localhost:8000/oauth/gmail/callback
# GOOGLE_DOCS_REDIRECT_URI=http://localhost:8000/oauth/google-docs/callback
# GOOGLE_SHEETS_REDIRECT_URI=http://localhost:8000/oauth/google-sheets/callback
# GOOGLE_SLIDES_REDIRECT_URI=http://localhost:8000/oauth/google-slides/callback
# GOOGLE_DRIVE_REDIRECT_URI=http://localhost:8000/oauth/google-drive/callback
# GOOGLE_CALENDAR_REDIRECT_URI=http://localhost:8000/oauth/google-calendar/callback
# VERCEL_REDIRECT_URI=http://localhost:8000/oauth/vercel/callback
