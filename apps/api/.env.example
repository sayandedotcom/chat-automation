# Better Auth Configuration
BETTER_AUTH_SECRET=your-32-character-or-longer-secret-key-here
BETTER_AUTH_URL=http://localhost:8000

# Google OAuth (copy from apps/web/.env or create in Google Cloud Console)
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Database (uses @workspace/database which requires DATABASE_URL)
# DATABASE_URL is typically set in packages/database/.env

DATABASE_URL=your-database-url

# Agent service URL (Python FastAPI)
AGENT_API_URL=http://localhost:8001

# Frontend URL — used for post-OAuth redirects
APP_URL=http://localhost:3000

# This API server's base URL — used to build OAuth callback URIs
API_BASE_URL=http://localhost:8000

# Notion OAuth
NOTION_CLIENT_ID=
NOTION_CLIENT_SECRET=

# Vercel OAuth
VERCEL_CLIENT_ID=
VERCEL_CLIENT_SECRET=

# Optional: override individual OAuth callback URIs
# (defaults to ${API_BASE_URL}/oauth/{provider}/callback)
# GMAIL_REDIRECT_URI=http://localhost:8000/oauth/gmail/callback
# GOOGLE_DOCS_REDIRECT_URI=http://localhost:8000/oauth/google-docs/callback
# GOOGLE_SHEETS_REDIRECT_URI=http://localhost:8000/oauth/google-sheets/callback
# GOOGLE_SLIDES_REDIRECT_URI=http://localhost:8000/oauth/google-slides/callback
# GOOGLE_DRIVE_REDIRECT_URI=http://localhost:8000/oauth/google-drive/callback
# GOOGLE_CALENDAR_REDIRECT_URI=http://localhost:8000/oauth/google-calendar/callback
# NOTION_REDIRECT_URI=http://localhost:8000/oauth/notion/callback
# VERCEL_REDIRECT_URI=http://localhost:8000/oauth/vercel/callback