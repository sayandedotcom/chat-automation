# ─── Database (PostgreSQL) ───
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/chatautomation?schema=public

# ─── LLM (Google Gemini) ───
GOOGLE_API_KEY=your-gemini-api-key

# ─── Web Search (Tavily) ───
TAVILY_API_KEY=tvly-your-tavily-api-key

# ─── OAuth Tokens (populated by API after OAuth flow) ───
