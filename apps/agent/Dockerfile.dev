# ============================================
# Stage 1: Install Python dependencies (cached)
# ============================================
FROM python:3.13-slim AS deps

WORKDIR /app

# Install uv for fast dependency resolution
COPY --from=ghcr.io/astral-sh/uv:latest /uv /usr/local/bin/uv

# Copy only manifests first — this layer is cached unless deps change
COPY pyproject.toml uv.lock ./
COPY chat/pyproject.toml chat/pyproject.toml

# Install all dependencies into /app/.venv (skip the project itself for now)
RUN uv sync --frozen --no-dev --no-install-project --package chat

# ============================================
# Stage 2: Development runner (extends deps)
# ============================================
FROM deps AS runner

WORKDIR /app

# Install Node.js for MCP servers (workspace-mcp requires npx)
RUN apt-get update && apt-get install -y --no-install-recommends \
    nodejs \
    npm \
    && rm -rf /var/lib/apt/lists/*

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONIOENCODING=utf-8 \
    PYTHONPATH="/app/chat/src" \
    PATH="/app/.venv/bin:/usr/local/bin:$PATH"

# Copy source after deps so cache is only busted on source changes
COPY . .

# Install the chat project package into the already-populated venv
RUN uv sync --frozen --no-dev --package chat

EXPOSE 8001

# Use the venv python directly; --reload watches /app/chat/src for changes
CMD ["/app/.venv/bin/python", "-m", "uvicorn", "chat.api:app", \
     "--host", "0.0.0.0", "--port", "8001", \
     "--reload", "--reload-dir", "/app/chat/src"]
