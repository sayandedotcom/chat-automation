{
  "$schema": "https://unpkg.com/knip@latest/schema.json",
  "workspaces": {
    "apps/api": {
      "entry": ["src/index.ts"],
      "project": "src/**/*.ts"
    },
    "apps/web": {
      "entry": ["app/**/*.{ts,tsx}", "next.config.mjs"],
      "project": "app/**/*.{ts,tsx}"
    },
    "packages/database": {
      "entry": ["src/index.ts"],
      "project": "src/**/*.ts"
    },
    "packages/trpc": {
      "entry": ["src/index.ts"],
      "project": "src/**/*.{ts,tsx}"
    },
    "packages/ui": {
      "entry": ["src/**/*.{ts,tsx}"],
      "project": "src/**/*.{ts,tsx}"
    },
    "packages/eslint-config": {
      "entry": ["*.js"],
      "project": "*.js"
    },
    "packages/prettier-config": {
      "entry": ["index.json"]
    },
    "packages/typescript-config": {
      "entry": ["*.json"]
    }
  },
  "ignore": ["**/node_modules/**", "**/dist/**", "**/.next/**", "**/.turbo/**"],
  "ignoreBinaries": [],
  "ignoreDependencies": []
}
