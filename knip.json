{
  "$schema": "https://unpkg.com/knip@latest/schema.json",
  "workspaces": {
    "apps/api": {
      "entry": ["src/index.ts"],
      "project": "src/**/*.ts"
    },
    "apps/web": {
      "entry": ["app/**/*.{ts,tsx}", "next.config.mjs"],
      "project": "app/**/*.{ts,tsx}"
    },
    "packages/database": {
      "entry": ["src/index.ts"],
      "project": "src/**/*.ts"
    },
    "packages/trpc": {
      "entry": ["src/index.ts"],
      "project": "src/**/*.{ts,tsx}"
    },
    "packages/ui": {
      "entry": ["src/**/*.{ts,tsx}"],
      "project": "src/**/*.{ts,tsx}"
    },
    "packages/eslint-config": {
      "entry": ["*.js"],
      "project": "*.js"
    },
    "packages/prettier-config": {
      "entry": ["index.json"]
    },
    "packages/typescript-config": {
      "entry": ["*.json"]
    }
  },
  "ignore": [
    "**/node_modules/**",
    "**/dist/**",
    "**/.next/**",
    "**/.turbo/**",
    "**/.sst/**"
  ],
  "ignoreBinaries": ["uv", "sst"],
  "ignoreDependencies": [
    "@types/aws-lambda",
    "@types/express-session",
    "@tailwindcss/postcss",
    "@workspace/eslint-config",
    "@workspace/prettier-config",
    "lint-staged",
    "@typescript-eslint/eslint-plugin",
    "@typescript-eslint/parser",
    "@types/express-serve-static-core",
    "@types/qs",
    "@turbo/gen",
    "sst",
    "postcss-load-config"
  ]
}
