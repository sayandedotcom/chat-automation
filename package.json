{
  "name": "chat-automation",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "build": "turbo build",
    "dev": "dotenv -- turbo dev",
    "lint": "dotenv -- turbo lint && cd apps/agent && uv run ruff check && uv run ruff format",
    "lint:fix": "dotenv -- turbo lint -- --fix && cd apps/agent && uv run ruff check --fix && uv run ruff format",
    "format": "prettier --write \"**/*.{cjs,mjs,js,jsx,cts,mts,ts,tsx,html,css,json,md}\"",
    "format:check": "prettier --check \"**/*.{cjs,mjs,js,jsx,cts,mts,ts,tsx,html,css,json,md}\"",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "db:generate": "turbo db:generate --filter=@workspace/database",
    "db:push": "dotenv -- turbo db:push --filter=@workspace/database",
    "db:migrate": "dotenv -- turbo db:migrate --filter=@workspace/database",
    "db:studio": "dotenv -- turbo db:studio --filter=@workspace/database",
    "knip": "knip --no-exit-code",
    "type-coverage": "type-coverage",
    "bundlewatch": "test -d apps/web/.next && bundlewatch || echo 'No build found, skipping bundlewatch'",
    "prepare": "husky",
    "clean": "turbo clean && rimraf node_modules",
    "nuke": "pnpm clean && rimraf node_modules"
  },
  "devDependencies": {
    "@changesets/cli": "^2.30.0",
    "@commitlint/cli": "^20.4.3",
    "@commitlint/config-conventional": "^20.4.3",
    "@trivago/prettier-plugin-sort-imports": "^6.0.2",
    "@workspace/eslint-config": "workspace:*",
    "@workspace/prettier-config": "workspace:*",
    "@workspace/typescript-config": "workspace:*",
    "bundlewatch": "^0.4.0",
    "dotenv-cli": "^11.0.0",
    "eslint": "^10.0.3",
    "husky": "^9.1.7",
    "knip": "^5.46.0",
    "lint-staged": "^16.3.3",
    "prettier": "^3.8.1",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "rimraf": "^6.0.1",
    "turbo": "^2.8.15",
    "type-coverage": "^2.29.7",
    "typescript": "5.9.3"
  },
  "packageManager": "pnpm@10.4.1",
  "engines": {
    "node": ">=20"
  },
  "pnpm": {
    "overrides": {
      "@types/react": "19.1.9",
      "@types/react-dom": "19.1.7"
    }
  }
}
