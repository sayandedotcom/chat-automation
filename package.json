{
  "name": "chat-automation",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "lint": "turbo lint && cd apps/agent && uv run ruff check && uv run ruff format",
    "format": "turbo format",
    "format:check": "turbo format:check",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "knip": "knip --no-exit-code",
    "type-coverage": "type-coverage",
    "bundlewatch": "test -d apps/web/.next && bundlewatch || echo 'No build found, skipping bundlewatch'",
    "prepare": "husky",
    "clean": "rimraf .turbo node_modules"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.8.0",
    "@commitlint/config-conventional": "^19.8.0",
    "@workspace/eslint-config": "workspace:*",
    "@workspace/prettier-config": "workspace:*",
    "@workspace/typescript-config": "workspace:*",
    "bundlewatch": "^0.4.0",
    "eslint": "^9.32.0",
    "husky": "^9.1.7",
    "knip": "^5.46.0",
    "lint-staged": "^15.5.0",
    "prettier": "^3.7.4",
    "rimraf": "^6.0.1",
    "type-coverage": "^2.29.7",
    "turbo": "^2.6.3",
    "typescript": "5.7.3"
  },
  "packageManager": "pnpm@10.4.1",
  "engines": {
    "node": ">=20"
  },
  "pnpm": {
    "overrides": {
      "@types/react": "19.1.9",
      "@types/react-dom": "19.1.7"
    }
  },
  "lint-staged": {
    "(apps|packages)/**/*.{js,ts,jsx,tsx}": [
      "prettier --write",
      "eslint --fix"
    ]
  }
}
