{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "globalDotEnv": [".env"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [".next/**", "!.next/cache/**"],
      "env": [
        "NEXT_PUBLIC_APP_URL",
        "NEXT_PUBLIC_API_URL",
        "BETTER_AUTH_SECRET",
        "GOOGLE_CLIENT_ID",
        "GOOGLE_CLIENT_SECRET",
        "DATABASE_URL",
        "NOTION_CLIENT_ID",
        "NOTION_CLIENT_SECRET",
        "NOTION_REDIRECT_URI",
        "APP_URL",
        "API_BASE_URL",
        "AGENT_API_URL",
        "GOOGLE_API_KEY",
        "TAVILY_API_KEY"
      ]
    },
    "lint": {
      "dependsOn": ["^lint"],
      "env": [
        "NODE_ENV",
        "PORT",
        "SESSION_SECRET",
        "GOOGLE_CALLBACK_URL",
        "GMAIL_REDIRECT_URI",
        "GOOGLE_CALENDAR_REDIRECT_URI",
        "GOOGLE_DOCS_REDIRECT_URI",
        "GOOGLE_DRIVE_REDIRECT_URI",
        "GOOGLE_SHEETS_REDIRECT_URI",
        "GOOGLE_SLIDES_REDIRECT_URI",
        "VERCEL_CLIENT_ID",
        "VERCEL_CLIENT_SECRET",
        "VERCEL_REDIRECT_URI"
      ]
    },
    "check-types": {
      "dependsOn": ["^check-types"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck"]
    },
    "format": {
      "dependsOn": ["^format"]
    },
    "format:check": {
      "dependsOn": ["^format:check"]
    },
    "test": {
      "dependsOn": ["^test"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
