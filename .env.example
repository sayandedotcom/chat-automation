# =============================================================================
# Chat Automation — Environment Variables (Single Root .env)
# Copy this file to .env and fill in the values
# =============================================================================

# ─── Database (PostgreSQL) ───
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://postgres:password@localhost:5432/chatautomation?schema=public"

# ─── Session (JWE encryption) ───
# Generate with: openssl rand -base64 32
SESSION_SECRET=

# ─── Google OAuth ───
# Create at: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:8000/auth/google/callback

# ─── Agent (LLM + Search) ───
# Get from Google AI Studio: https://aistudio.google.com/
GOOGLE_API_KEY=

# Get from Tavily: https://tavily.com/
TAVILY_API_KEY=

# ─── App URLs ───
APP_URL=http://localhost:3000
API_BASE_URL=http://localhost:8000
AGENT_API_URL=http://localhost:8080
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000

# ─── Notion OAuth (Optional) ───
# NOTION_CLIENT_ID=
# NOTION_CLIENT_SECRET=
# NOTION_REDIRECT_URI=http://localhost:8000/oauth/notion/callback

# ─── Optional: per-integration OAuth callback URIs ───
# GMAIL_REDIRECT_URI=http://localhost:8000/oauth/gmail/callback
# GOOGLE_DOCS_REDIRECT_URI=http://localhost:8000/oauth/google-docs/callback
# GOOGLE_SHEETS_REDIRECT_URI=http://localhost:8000/oauth/google-sheets/callback
# GOOGLE_SLIDES_REDIRECT_URI=http://localhost:8000/oauth/google-slides/callback
# GOOGLE_DRIVE_REDIRECT_URI=http://localhost:8000/oauth/google-drive/callback
# GOOGLE_CALENDAR_REDIRECT_URI=http://localhost:8000/oauth/google-calendar/callback
# VERCEL_REDIRECT_URI=http://localhost:8000/oauth/vercel/callback

# ─── Langsmith Tracing (Optional) ───
# LANGSMITH_TRACING=false
# LANGSMITH_ENDPOINT=https://api.smith.langchain.com
# LANGSMITH_API_KEY=
# LANGSMITH_PROJECT=
