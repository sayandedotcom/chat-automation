# =============================================================================
# Chat Automation — Environment Variables (Local Development)
# Copy this file to .env and fill in the values
# =============================================================================

# ─── App URLs ───
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000
APP_URL=http://localhost:3000
API_BASE_URL=http://localhost:8000
AGENT_API_URL=http://localhost:8001

# ─── Database (PostgreSQL) ───
# Local PostgreSQL or cloud provider (e.g., Neon, Supabase)
DATABASE_URL=

# ─── Session (JWE encryption) ───
# Generate with: openssl rand -base64 32
SESSION_SECRET=

# ─── Google OAuth ───
# Create credentials at: https://console.cloud.google.com/apis/credentials
# Add http://localhost:8000/auth/google/callback as an authorized redirect URI
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:8000/auth/google/callback

# ─── Vercel OAuth (Optional) ───
# VERCEL_CLIENT_ID=
# VERCEL_CLIENT_SECRET=
# VERCEL_REDIRECT_URI=http://localhost:8000/oauth/vercel/callback

# ─── Notion OAuth (Optional) ───
# NOTION_CLIENT_ID=
# NOTION_CLIENT_SECRET=
# NOTION_REDIRECT_URI=http://localhost:8000/oauth/notion/callback

# ─── Agent (LLM + Search) ───
# Get from Google AI Studio: https://aistudio.google.com/
GOOGLE_API_KEY=

# Get from Tavily: https://tavily.com/
TAVILY_API_KEY=

# ─── LangSmith Tracing (Optional) ───
# LANGSMITH_TRACING=false
# LANGSMITH_ENDPOINT=https://api.smith.langchain.com
# LANGSMITH_API_KEY=
# LANGSMITH_PROJECT=
