{
  "name": "@workspace/trpc",
  "version": "1.1.0",
  "description": "Centralized tRPC server and client for chat-automation",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "import": "./src/index.ts",
      "types": "./src/index.ts"
    },
    "./server": {
      "import": "./src/server/index.ts",
      "types": "./src/server/index.ts"
    },
    "./client": {
      "import": "./src/client/index.ts",
      "types": "./src/client/index.ts"
    },
    "./client/react": {
      "import": "./src/client/react.tsx",
      "types": "./src/client/react.tsx"
    },
    "./adapters/express": {
      "import": "./src/adapters/express.ts",
      "types": "./src/adapters/express.ts"
    },
    "./lib/token-utils": {
      "import": "./src/lib/token-utils.ts",
      "types": "./src/lib/token-utils.ts"
    }
  },
  "scripts": {
    "build": "tsc",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"src/**/*.ts\" \"src/**/*.tsx\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"src/**/*.tsx\"",
    "typecheck": "tsc --noEmit",
    "clean": "rimraf .turbo node_modules dist"
  },
  "keywords": [
    "trpc",
    "api",
    "typescript"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@tanstack/react-query": "^5.80.7",
    "@trpc/client": "^11.8.1",
    "@trpc/server": "^11.8.1",
    "@trpc/tanstack-react-query": "^11.8.1",
    "superjson": "^2.2.2",
    "zod": "^4.3.6"
  },
  "peerDependencies": {
    "express": "^4.18.0 || ^5.0.0",
    "react": "^18.0.0 || ^19.0.0"
  },
  "peerDependenciesMeta": {
    "express": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@workspace/eslint-config": "workspace:*",
    "@workspace/prettier-config": "workspace:*",
    "eslint": "^9.32.0",
    "prettier": "^3.7.4",
    "rimraf": "^6.0.1",
    "@types/express-serve-static-core": "^5.1.1",
    "@types/node": "^22.15.32",
    "@types/qs": "^6.14.0",
    "@types/react": "^19.1.9",
    "@workspace/typescript-config": "workspace:*",
    "typescript": "^5.9.3"
  }
}
