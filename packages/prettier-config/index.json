{
  "bracketSpacing": true,
  "semi": true,
  "arrowParens": "always",
  "bracketSameLine": true,
  "singleQuote": false,
  "jsxSingleQuote": false,
  "trailingComma": "es5",
  "printWidth": 100,
  "tabWidth": 2,
  "endOfLine": "lf",
  "importOrder": [
    "^react$",
    "^(next/(.*)$)|^(next$)",
    "<THIRD_PARTY_MODULES>",
    "^@workspace/(.*)$",
    "^@/actions/(.*)$",
    "^@referrer/(.*)$",
    "^@/components/(.*)$",
    "^@/lib/(.*)$",
    "^@/config/(.*)$",
    "^@/config$",
    "^@/utils$",
    "^@/store/(.*)$",
    "^@/hooks/(.*)$",
    "^@/public/(.*)$",
    "^@/types/(.*)$",
    "^[./]"
  ],
  "importOrderSeparation": true,
  "importOrderSortSpecifiers": true,
  "tailwindFunctions": ["clsx"],
  "plugins": [
    "@trivago/prettier-plugin-sort-imports",
    "prettier-plugin-tailwindcss"
  ]
}
